# downloaded or built files that can be rebuilt
node_modules/
dist/
target/

# editor settings
.classpath
.project
.settings/
.idea/
.vscode/
*.iml

# secrets and real data: never commit these
.env
*.log
*.sql.gz
*.dump
backups/

cat >> .gitignore << 'EOF'

# made while building the installer
desktop/dist-installer/
packaging/stage/
packaging/downloads/
backend/src/main/resources/static/
EOF
